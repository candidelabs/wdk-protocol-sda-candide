# Forwarding Address API URL, copied as shown in the Candide dashboard (it carries the team API key).
CANDIDE_FORWARDING_API_URL=
# Forwarding policy secret from the dashboard. Server-side only; needed to activate addresses.
CANDIDE_FORWARDING_POLICY_SECRET=

# Recipient used by the live integration tests (npm run test:integration).
# Nothing is sent to it, but use an address you control.
TEST_RECIPIENT=
# Optional; defaults to TEST_RECIPIENT.
TEST_CUSTODIAL_WITHDRAWER=

# Live deposit lifecycle test (see README "Development"): deposits already sent to the test address.
# TEST_DEPOSIT_TXS=8453:0x<txHash>,42161:0x<txHash>
# TEST_DESTINATION_CHAIN=42161
